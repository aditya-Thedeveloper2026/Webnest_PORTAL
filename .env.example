# Supabase Edge Function configuration is injected by the Supabase runtime.
# BOOTSTRAP_SECRET is set temporarily via `supabase secrets set` and removed after bootstrap.
BOOTSTRAP_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET

# Browser values go in frontend/config.js (publishable/anon key only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# NEVER place SUPABASE_SERVICE_ROLE_KEY in a frontend file or commit it to Git.
